# Copy to .env before running docker compose:
#   cp .env.example .env
# The .env file is git-ignored. Replace every "change-me" value for anything
# that is not a throwaway local environment.

# --- Local MySQL (matches the historical parking-mysql volume) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=parking_platform
MYSQL_USER=parking
MYSQL_PASSWORD=parking

# --- Backend ---
# Generate for real environments with: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-secret-0123456789-0123456789-0123456789
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
APP_TIMEZONE=Asia/Kolkata
# Optional: seed demo venues/users on startup.
APP_SEED_DEMO=false
# Optional: create the first admin on startup (register is disabled for ADMIN).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Vision service ---
VISION_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Must be an ADMIN or MANAGER account; only needed when the pipeline pushes events.
VISION_PARKING_USER=manager@parking.dev
VISION_PARKING_PASSWORD=change-me-vision-password
CAMERA_CODE=CAM-L1
